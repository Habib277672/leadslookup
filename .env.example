# Public site URL, no trailing slash. Leave empty until a real domain exists
# (while empty, the site is served with noindex).
NEXT_PUBLIC_SITE_URL=

# Runtime connection used by the app.
# Supabase: transaction pooler, port 6543.  Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Migration connection used by the Prisma CLI.
# Supabase: session pooler, port 5432.
DIRECT_URL=

# RS256 signing key (base64 of a PKCS8 PEM). Generate: node scripts/generate-auth-key.mjs
AUTH_JWT_PRIVATE_KEY_B64=